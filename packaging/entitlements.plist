<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime (required for notarization).
  Python/ctypes allocates executable memory; without this entitlement the app crashes
  on start-up under the hardened runtime. The app needs nothing else: no network
  entitlement (only applies in the sandbox), ExifTool runs via /usr/bin/perl.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
